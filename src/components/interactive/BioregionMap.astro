---
// Satellite view of the Front Range corridor. Replaces the earlier abstract
// SVG map with a true overhead image of the bioregion.
import { basePath } from '../../lib/paths';

const src = basePath('/images/landscape/front-range-satellite.jpg');
---

<figure class="bioregion-map relative">
  <div class="relative border border-ink overflow-hidden bg-ink">
    <img
      src={src}
      alt="Satellite image of the Colorado Front Range corridor, where the Rocky Mountains meet the high plains."
      class="w-full h-auto block object-cover"
      loading="lazy"
      decoding="async"
    />
    {/* Inner hairline frame for the almanac feel */}
    <div class="absolute inset-0 pointer-events-none border border-bone-pale/20 m-1.5"></div>
    <figcaption class="absolute bottom-0 left-0 right-0 px-3 py-2 flex items-baseline justify-between gap-3
                       font-mono text-[0.62rem] uppercase tracking-[0.16em] text-bone-pale/90"
                style="background: linear-gradient(180deg, transparent 0%, rgba(31,30,27,0.78) 100%);">
      <span>fig. 1 · the corridor</span>
      <span class="opacity-80">satellite · the Front Range</span>
    </figcaption>
  </div>
</figure>
