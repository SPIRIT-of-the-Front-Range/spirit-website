---
import { getEntry } from 'astro:content';
import { basePath, resolveLink } from '../../lib/paths';

const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing src/content/settings/site.md');
const { siteName, wordmarkSrc, header, announcement } = settings.data;
const announcementLink = announcement?.enabled ? resolveLink(announcement.ctaHref) : null;

const nav = header.nav.map((item) => ({
  label: item.label,
  link: resolveLink(item.href),
}));

const path = Astro.url.pathname;
const today = new Date().toLocaleString('en-US', { month: 'long', year: 'numeric' });
const donateLink = resolveLink('donate/');
const subscribeHref = header.subscribeHref ?? 'https://dashboard.spiritofthefrontrange.org/subscribe';
const subscribeLabel = header.subscribeLabel ?? 'Subscribe';
---

{/* Masthead — true periodical nameplate */}
<header class="site-header bg-bone relative z-30">

  {/* Top thin strip — quiet site banner (hidden on home where cover provides masthead) */}
  <div class={`border-b border-ink ${path === '/' ? 'lg:hidden' : ''}`}>
    <div class="almanac-edge flex items-center justify-between gap-4 py-2 text-[10px] sm:text-[11px]">
      <span class="font-mono uppercase tracking-[0.22em] text-shadow font-bold">
        {siteName}
      </span>
      <span class="font-mono uppercase tracking-[0.22em] text-shadow">
        {today}
      </span>
    </div>
  </div>

  {/* Main masthead — nameplate row */}
  <div class="border-b-4 border-ink">
    <div class="almanac-edge grid grid-cols-12 items-center gap-4 py-3 lg:py-4">

      {/* Left: subscribe — mirrors donate on the right */}
      <div class="col-span-3 lg:col-span-3 flex justify-start items-center">
        <a href={subscribeHref} rel="noopener" target="_blank" class="hidden lg:inline-flex btn-line !py-2 !px-3 !text-[10px]">
          {subscribeLabel}
        </a>
      </div>

      {/* Center: nameplate — hand-drawn wordmark */}
      <a href={basePath('')} class="col-span-6 lg:col-span-6 no-underline flex justify-center" aria-label={`${siteName} — home`}>
        <img
          src={basePath(wordmarkSrc)}
          alt={siteName}
          width="1067"
          height="1067"
          class="block w-auto h-16 sm:h-20 lg:h-24 object-contain wordmark-img"
          loading="eager"
          decoding="async"
        />
      </a>

      {/* Right: donate — mirrors subscribe on the left */}
      <div class="col-span-3 lg:col-span-3 flex justify-end items-center gap-2">
        <a href={donateLink.href} class="hidden lg:inline-flex btn-ink !py-2 !px-3 !text-[10px]">
          {header.donateLabel}
        </a>
        {/* Mobile menu toggle */}
        <details class="lg:hidden relative">
          <summary class="list-none cursor-pointer p-2" aria-label="Open menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="3" y1="7"  x2="21" y2="7"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="17" x2="21" y2="17"/>
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-2 w-64 bg-bone border-2 border-ink p-4 z-40">
            <ul class="flex flex-col gap-1">
              {nav.map(item => (
                <li>
                  <a href={item.link.href} rel={item.link.rel} class="block no-underline font-mono uppercase text-[11px] tracking-[0.18em] py-2.5 text-ink hover:text-clay-deep">
                    → {item.label}
                  </a>
                </li>
              ))}
              <li class="border-t-2 border-ink pt-3 mt-2">
                <a href={subscribeHref} rel="noopener" target="_blank" class="block no-underline font-mono uppercase text-[11px] tracking-[0.2em] font-bold py-2 text-creek-deep">
                  ✦ {subscribeLabel}
                </a>
              </li>
              <li>
                <a href={donateLink.href} class="block no-underline font-mono uppercase text-[11px] tracking-[0.2em] font-bold py-2 text-clay-deep">
                  {header.mobileDonateLabel}
                </a>
              </li>
            </ul>
          </div>
        </details>
      </div>

    </div>
  </div>

  {/* Nav strip — under masthead */}
  <nav aria-label="Primary" class="hidden lg:block border-b border-ink bg-bone">
    <div class="almanac-edge">
      <ul class="flex items-stretch justify-center gap-0 -mx-2">
        {nav.map((item, i) => {
          const active = path === item.link.href || (item.link.href !== '/' && path.startsWith(item.link.href));
          return (
            <li class="contents">
              <a
                href={item.link.href}
                rel={item.link.rel}
                class:list={[
                  'no-underline px-5 py-3 font-mono text-[11px] uppercase tracking-[0.2em] font-bold transition-colors text-center',
                  active ? 'text-clay-deep' : 'text-ink hover:text-clay-deep'
                ]}
              >
                {item.label}
              </a>
              {i < nav.length - 1 && <span class="text-rule self-center" aria-hidden="true">·</span>}
            </li>
          );
        })}
      </ul>
    </div>
  </nav>

  {/* Announcement strip — site-wide notice under the masthead */}
  {announcement?.enabled && announcementLink && (
    <a
      href={announcementLink.href}
      rel={announcementLink.rel}
      target={announcement.ctaHref.startsWith('http') ? '_blank' : undefined}
      class="block no-underline bg-clay-deep border-b-2 border-ink group"
    >
      <div class="almanac-edge flex items-baseline justify-center gap-x-3 gap-y-0.5 flex-wrap py-2.5 text-center">
        <span class="font-mono uppercase tracking-[0.22em] font-bold text-[10px]" style="color:#E8B58A;">
          ★ {announcement.eyebrow}
        </span>
        <span class="font-serif italic text-[13px] sm:text-[14px] leading-snug" style="color:#F7EFD8;">
          {announcement.message}
        </span>
        <span class="font-mono uppercase tracking-[0.18em] font-bold text-[10px] underline underline-offset-4 decoration-1 group-hover:decoration-2" style="color:#F2EAD8;">
          {announcement.ctaLabel}
        </span>
      </div>
    </a>
  )}
</header>
